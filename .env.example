# Required
DATABASE_URL=postgres://user:password@host:5432/dbname
# Long random string (openssl rand -hex 32). Protects the reminder cron endpoint.
CRON_SECRET=
# Public URL of the app, used in emails (no trailing slash)
APP_URL=https://your-app.vercel.app

# AI advisor (optional until you have a key)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Advisor questions per company per month
ADVISOR_MONTHLY_LIMIT=50

# Email: password reset, invites, Monday reminders (optional until configured)
RESEND_API_KEY=
EMAIL_FROM=Growth Planner <hello@yourdomain.com>
