# Required
# Supabase (Mumbai, ap-south-1) transaction pooler URI, port 6543
DATABASE_URL=postgres://postgres.<project>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# Long random string (openssl rand -hex 32). Protects the reminder cron endpoint.
CRON_SECRET=
# Public URL of the app, used in emails (no trailing slash)
APP_URL=https://your-app.vercel.app

# AI advisor (optional until you have a key)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Advisor questions per company per month
ADVISOR_MONTHLY_LIMIT=50

# Email: password reset, invites, Monday reminders (optional until configured)
RESEND_API_KEY=
EMAIL_FROM=Growth Planner <hello@yourdomain.com>

# Google sign-in (optional). Create an OAuth client at console.cloud.google.com,
# authorised redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Zoho Books (optional). Server-based app at https://api-console.zoho.in/,
# redirect URI: <APP_URL>/api/zoho/callback
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Encrypts stored Zoho tokens (openssl rand -hex 32)
ENCRYPTION_KEY=
